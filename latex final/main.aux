\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Influence of Kernel Parameters $\alpha $ and $\beta $}{8}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Impact of kernel parameters on intensity dynamics.} Both processes share the same branching ratio $n=0.8$ and baseline $\mu =1.0$. \text  {Left:} High excitation ($\alpha =4.0$) and fast decay ($\beta =5.0$) lead to sharp intensity spikes that quickly return to baseline. \text  {Right:} Low excitation ($\alpha =0.4$) and slow decay ($\beta =0.5$) produce smaller increases but prolonged elevated intensity levels. }}{9}{figure.caption.4}\protected@file@percent }
\newlabel{fig:intensity_influence}{{1}{9}{\textbf {Impact of kernel parameters on intensity dynamics.} Both processes share the same branching ratio $n=0.8$ and baseline $\mu =1.0$. \text {Left:} High excitation ($\alpha =4.0$) and fast decay ($\beta =5.0$) lead to sharp intensity spikes that quickly return to baseline. \text {Right:} Low excitation ($\alpha =0.4$) and slow decay ($\beta =0.5$) produce smaller increases but prolonged elevated intensity levels}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Clustering Effect on the Distribution of Claims}{9}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Distribution of claim counts ($T=50$).} The Hawkes process (red) shows a wider distribution compared to the Poisson reference, despite having the same theoretical mean. This indicates a higher probability of extreme claim volumes for the Hawkes case.}}{9}{figure.caption.5}\protected@file@percent }
\newlabel{fig:clustering_hist}{{2}{9}{\textbf {Distribution of claim counts ($T=50$).} The Hawkes process (red) shows a wider distribution compared to the Poisson reference, despite having the same theoretical mean. This indicates a higher probability of extreme claim volumes for the Hawkes case}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Impact of the Clustering Effect on the Risk of Ruin}{10}{section.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Simulation Framework}{10}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Comparison of intensity dynamics.} \text  {Left:} Homogeneous Poisson Process — constant intensity. \text  {Middle:} Inhomogeneous Poisson Process — deterministic seasonal intensity. \text  {Right:} Hawkes process: self-exciting intensity with jumps after events and exponential decay, generating clustering and sharp drops in the surplus $R(t)$.}}{10}{figure.caption.6}\protected@file@percent }
\newlabel{fig:three_paths}{{3}{10}{\textbf {Comparison of intensity dynamics.} \text {Left:} Homogeneous Poisson Process — constant intensity. \text {Middle:} Inhomogeneous Poisson Process — deterministic seasonal intensity. \text {Right:} Hawkes process: self-exciting intensity with jumps after events and exponential decay, generating clustering and sharp drops in the surplus $R(t)$}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Quantifying the Cost of Clustering: A Comparison Between Hawkes and Poisson Models}{11}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Probability of ruin $\psi (u)$ as a function of the premium rate $c$.} Results are estimated using 500 Monte Carlo simulations over a time horizon $T=100$. Both models share the same average intensity $\lambda \approx \lambda _{eq}$ and initial capital $u$. The vertical dotted line represents the Net Profit Condition (NPC) threshold. The shaded region corresponds to the regime where the NPC is violated, leading to almost certain ruin. The Hawkes process exhibits systematically higher ruin probabilities due to the clustering effect.}}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:ruin_comparison}{{4}{12}{\textbf {Probability of ruin $\psi (u)$ as a function of the premium rate $c$.} Results are estimated using 500 Monte Carlo simulations over a time horizon $T=100$. Both models share the same average intensity $\lambda \approx \lambda _{eq}$ and initial capital $u$. The vertical dotted line represents the Net Profit Condition (NPC) threshold. The shaded region corresponds to the regime where the NPC is violated, leading to almost certain ruin. The Hawkes process exhibits systematically higher ruin probabilities due to the clustering effect}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Probability of ruin under three self-exciting regimes.} The x-axis represents the premium rate $c$, and the y-axis shows the ruin probability $\psi (u)$. The vertical dotted line indicates the Net Profit Condition (NPC), which is identical for all regimes. The three curves correspond to low ($n^*=0.2$), medium ($n^*=0.5$), and critical ($n^*=0.9$) self-excitation regimes. Higher self-excitation leads to systematically higher ruin probabilities, even though the average intensity $\lambda $ is the same.}}{12}{figure.caption.11}\protected@file@percent }
\newlabel{fig:ruin_regimes}{{5}{12}{\textbf {Probability of ruin under three self-exciting regimes.} The x-axis represents the premium rate $c$, and the y-axis shows the ruin probability $\psi (u)$. The vertical dotted line indicates the Net Profit Condition (NPC), which is identical for all regimes. The three curves correspond to low ($n^*=0.2$), medium ($n^*=0.5$), and critical ($n^*=0.9$) self-excitation regimes. Higher self-excitation leads to systematically higher ruin probabilities, even though the average intensity $\lambda $ is the same}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Ruin probability as a function of the initial capital $u$.} The premium rate is fixed at $c = 3.5$, ensuring a profitable regime ($c>\text  {NPC}$). The Hawkes model consistently exhibits higher ruin probabilities due to claim clustering. The decay of the curves illustrates the classical Lundberg-type exponential behavior.}}{13}{figure.caption.13}\protected@file@percent }
\newlabel{fig:ruin_vs_u}{{6}{13}{\textbf {Ruin probability as a function of the initial capital $u$.} The premium rate is fixed at $c = 3.5$, ensuring a profitable regime ($c>\text {NPC}$). The Hawkes model consistently exhibits higher ruin probabilities due to claim clustering. The decay of the curves illustrates the classical Lundberg-type exponential behavior}{figure.caption.13}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Model Risk and Sensitivity Analysis to Parameter Estimation Errors}{13}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Impact of a 10\% calibration error on the probability of ruin.} The curves correspond to two self-exciting regimes: a stable regime ($n^*=0.65$) and a critical regime ($n^*=0.90$). The x-axis represents the estimation error applied to the self-excitation parameter $\alpha $, while the y-axis shows the resulting ruin probability $\psi (u)$. The vertical dashed line marks the exact calibration. The results highlight the high sensitivity of the critical regime to miscalibration, where even small positive errors can lead to a sharp increase in ruin probability, whereas the stable regime exhibits a more moderate response.}}{14}{figure.caption.14}\protected@file@percent }
\newlabel{fig:Calibration_error}{{7}{14}{\textbf {Impact of a 10\% calibration error on the probability of ruin.} The curves correspond to two self-exciting regimes: a stable regime ($n^*=0.65$) and a critical regime ($n^*=0.90$). The x-axis represents the estimation error applied to the self-excitation parameter $\alpha $, while the y-axis shows the resulting ruin probability $\psi (u)$. The vertical dashed line marks the exact calibration. The results highlight the high sensitivity of the critical regime to miscalibration, where even small positive errors can lead to a sharp increase in ruin probability, whereas the stable regime exhibits a more moderate response}{figure.caption.14}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Risk Mitigation Strategies: Stop-Loss Reinsurance}{14}{subsection.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Impact of Stop-Loss reinsurance under a critical Hawkes regime ($n^*=0.8$).} The simulation compares the Gross strategy (Blue) vs. the Net strategy with Stop-Loss (Green). \text  {(a) Capital Evolution:} The Blue area is very wide and unstable, showing that without reinsurance, the capital often drops dangerously close to zero. The Green area is much narrower: despite paying $20\%$ of the premiums for reinsurance, the capital grows steadily and stays safe. \text  {(b) Cumulative Ruin Probability:} Without reinsurance (Blue line), the risk of bankruptcy rises to $\approx 35\%$ due to sudden clusters of claims. With Stop-Loss (Green line), this risk is eliminated ($0\%$), as the reinsurance absorbs the shock of extreme events.}}{15}{figure.caption.19}\protected@file@percent }
\newlabel{fig:reinsurance_critical}{{8}{15}{\textbf {Impact of Stop-Loss reinsurance under a critical Hawkes regime ($n^*=0.8$).} The simulation compares the Gross strategy (Blue) vs. the Net strategy with Stop-Loss (Green). \text {(a) Capital Evolution:} The Blue area is very wide and unstable, showing that without reinsurance, the capital often drops dangerously close to zero. The Green area is much narrower: despite paying $20\%$ of the premiums for reinsurance, the capital grows steadily and stays safe. \text {(b) Cumulative Ruin Probability:} Without reinsurance (Blue line), the risk of bankruptcy rises to $\approx 35\%$ due to sudden clusters of claims. With Stop-Loss (Green line), this risk is eliminated ($0\%$), as the reinsurance absorbs the shock of extreme events}{figure.caption.19}{}}
