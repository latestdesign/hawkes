\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Simulation framework: Ogata's algorithm and intensity validation}{6}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Comparison of intensity dynamics.} \text  {Left:} Homogeneous Poisson Process — constant intensity. \text  {Middle:} Inhomogeneous Poisson Process — deterministic seasonal intensity. \text  {Right:} Hawkes process — self-exciting intensity with jumps after events and exponential decay, generating clustering and sharp drops in the surplus $R(t)$.}}{6}{}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:three_paths}{{1}{6}{}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Quantifying the cost of clustering: A comparison between Hawkes and Poisson models}{6}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Probability of ruin $\psi (u)$ as a function of the premium rate $c$.} Both models share the same average intensity $\lambda \approx \lambda _{eq}$ and initial capital $u$. The vertical dotted line represents the Net Profit Condition (NPC) threshold. The shaded region corresponds to the regime where the NPC is violated, leading to almost certain ruin. The Hawkes process exhibits systematically higher ruin probabilities due to the clustering effect.}}{7}{}\protected@file@percent }
\newlabel{fig:ruin_comparison}{{2}{7}{}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Probability of ruin under three self-exciting regimes.} The x-axis represents the premium rate $c$, and the y-axis shows the ruin probability $\psi (u)$. The vertical dotted line indicates the Net Profit Condition (NPC), which is identical for all regimes. The three curves correspond to low ($n^*=0.2$), medium ($n^*=0.5$), and critical ($n^*=0.9$) self-excitation regimes. Higher self-excitation leads to systematically higher ruin probabilities, even though the average intensity $\lambda $ is the same.}}{7}{}\protected@file@percent }
\newlabel{fig:ruin_regimes}{{3}{7}{}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Ruin probability as a function of the initial capital $u$.} The premium rate is fixed at $c = 3.5$, ensuring a profitable regime ($c>\text  {NPC}$). The Hawkes model consistently exhibits higher ruin probabilities due to claim clustering. The decay of the curves illustrates the classical Lundberg-type exponential behavior.}}{8}{}\protected@file@percent }
\newlabel{fig:ruin_vs_u}{{4}{8}{}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Model risk and sensitivity analysis to parameter estimation errors}{8}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Impact of a 10\% calibration error on the probability of ruin.} The curves correspond to two self-exciting regimes: a stable regime ($n^*=0.65$) and a critical regime ($n^*=0.90$). The x-axis represents the estimation error applied to the self-excitation parameter $\alpha $, while the y-axis shows the resulting ruin probability $\psi (u)$. The vertical dashed line marks the exact calibration. The results highlight the high sensitivity of the critical regime to miscalibration, where even small positive errors can lead to a sharp increase in ruin probability, whereas the stable regime exhibits a more moderate response.}}{8}{}\protected@file@percent }
\newlabel{fig:Calibration_error}{{5}{8}{}{figure.5}{}}
\bibcite{efficientnet}{1}
\bibcite{rmsprop}{2}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Risk mitigation strategies: Reinsurance}{9}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Impact of excess-of-loss reinsurance under a critical Hawkes regime.} The branching ratio is close to unity ($n^*=0.8$), corresponding to a highly unstable self-exciting regime. The x-axis represents the retention level $M$, while the y-axis shows the probability of ruin $\psi (u)$. Claim sizes follow an exponential distribution and are truncated by the reinsurance contract. As the retention level decreases, the insurer transfers more risk to the reinsurer, leading to a significant reduction in the probability of ruin.}}{9}{}\protected@file@percent }
\newlabel{fig:reinsurance_critical}{{6}{9}{}{figure.6}{}}
